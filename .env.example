# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tattoo_studio"

# Auth Configuration
AUTH_SECRET="your-secure-random-secret-here-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Site Configuration
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Ink & Needle Studio"

# Stripe Configuration
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"

# Email Configuration (Resend)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="noreply@yourstudio.com"
ADMIN_EMAIL="admin@yourstudio.com"

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Admin Credentials (for initial setup)
ADMIN_EMAIL_INITIAL="admin@example.com"
ADMIN_PASSWORD_INITIAL="temporary-password-change-after-first-login"
